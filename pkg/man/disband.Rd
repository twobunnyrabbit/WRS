\enumerate{
\item Computes shift function for groups \code{grp[1]} vs \code{grp[2]}
\item Computes shift function for groups \code{grp[3]} vs \code{grp[4]}
\item Plots both shift functions on the same axes (different line types)
\item Optionally smooths the shift functions for visual clarity
}

