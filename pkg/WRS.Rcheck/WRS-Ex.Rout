> ##D 
> ##D # Depth distribution method (recommended)
> ##D Depth.class(x1 = x1, x2 = x2, test = test, DIST = TRUE)
> ##D 
> ##D # Maximum depth method
> ##D Depth.class(x1 = x1, x2 = x2, test = test, DIST = FALSE)
> ##D 
> ##D # Using train/g specification
> ##D train <- rbind(x1, x2)
> ##D g <- c(rep(1, nrow(x1)), rep(2, nrow(x2)))
> ##D Depth.class(train = train, g = g, test = test)
