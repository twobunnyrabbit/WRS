> ### Name: DregG
> ### Title: Global Test for Comparing Two Dependent Regression Lines
> ### Aliases: DregG
> 
> ### ** Examples
> 
> # Simulated pre-post intervention data
> set.seed(123)
> n <- 50
> x1 <- rnorm(n)
> y1 <- 1 + 2*x1 + rnorm(n)
> x2 <- x1 + rnorm(n, sd=0.3)
> y2 <- 1.5 + 2.5*x2 + rnorm(n)  # Changed parameters
> 
> # Global test
> result <- DregG(x1, y1, x2, y2, nboot=500)
> print(result$p.value)
[1] 0.018
> 
> # Multiple predictors
> x1 <- matrix(rnorm(100), ncol=2)
> y1 <- 1 + 2*x1[,1] - x1[,2] + rnorm(50)
> x2 <- x1 + matrix(rnorm(100, sd=0.2), ncol=2)
> y2 <- 1.5 + 2.2*x2[,1] - 1.1*x2[,2] + rnorm(50)
> DregG(x1, y1, x2, y2, nboot=500)
$p.value
[1] 0.002

$est.1
[1]  1.038526  1.790671 -1.071007

$est.2
[1]  1.6911348  2.3009071 -0.9461232

$estimate.dif
[1] -0.6526093 -0.5102363 -0.1248836

> 
